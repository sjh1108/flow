# Copy to .env next to docker-compose.yml and fill in.
# Never commit the filled-in .env.

# --- MySQL ---------------------------------------------------------------
# These are the only place the passwords live. mysql-init/01-users.sh reads them
# when it creates the accounts, so there is nothing to keep in sync by hand.
#
# Generate all three with:
#
#   openssl rand -hex 32
#
# MIGRATOR_PASSWORD and APP_DB_PASSWORD are additionally *checked*: letters,
# digits, '_' and '-' only. Those two are interpolated into SQL by 01-users.sh,
# where a quote or a backslash would break the statement rather than weaken it
# -- the database would come up with no accounts at all. The script rejects
# them up front instead of letting that happen.
#
# MYSQL_ROOT_PASSWORD is not checked, because it never enters a SQL literal: the
# client reads it from MYSQL_PWD. Hex is still the sensible thing to generate,
# it just is not enforced.
#
# Set on first start: the init script runs once, against an empty data volume.
# Changing one afterwards means an ALTER USER as well.
#
# The two application accounts are deliberately separate. extguard_migrator owns
# the schema and is used only by the one-shot migrate container; extguard_app is
# what the running application connects as and cannot alter the schema or touch
# the fixed extensions. Giving them the same password would hand the application
# the migrator's rights and undo the split.
MYSQL_ROOT_PASSWORD=change-me-root
MIGRATOR_PASSWORD=change-me-migrator
APP_DB_PASSWORD=change-me-app

# --- Application ---------------------------------------------------------
# Host port for the API. The container always listens on 8080; this is only the
# address the host publishes, and it stays on the loopback interface either way.
#
# Leave it unset unless something else on this machine already holds 8080 --
# `docker compose up` fails with "port is already allocated" rather than falling
# back, so an instance running another project needs its own port here. Check
# with:  ss -ltn | grep :8080
#
# Whatever you set, the reverse proxy in front must point at the same port.
APP_HOST_PORT=8080

# Required on the policy write endpoints. Generate with:
#   openssl rand -base64 32
# Leaving this blank disables the guard entirely and logs a warning at startup.
EXTGUARD_ADMIN_TOKEN=

# Comma-separated. Must include the Vercel origin serving the frontend.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# --- TLS (only when running the optional caddy service) -------------------
# Unused when an existing reverse proxy on this machine terminates TLS: the
# caddy service sits behind the "with-tls" profile and does not start by default.
API_DOMAIN=api.example.com
