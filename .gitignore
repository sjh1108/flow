# Build output
build/
out/
target/
*.jar
# The wrapper jar must be committed or ./gradlew does not work on a fresh clone.
# The pattern needs ** because the wrapper lives under backend/, not the repo root.
!**/gradle/wrapper/gradle-wrapper.jar

# Gradle
.gradle/

# Local runtime data
data/
uploads/

# Secrets
.env
*.local

# Node (only used for the browser verification script)
# `npm install playwright` writes these; the app itself has no runtime
# dependencies and must not gain one by way of a committed manifest.
node_modules/
package.json
package-lock.json

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs
*.log
